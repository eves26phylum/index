{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "index",
	"compatibility_date": "2026-06-05",
	"observability": {
		"enabled": true
	},
	"assets": {
		"not_found_handling": "single-page-application",
		// "directory": "./dist"
	},
	"pages_build_output_dir": "./dist",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "pizza_db",
			"database_name": "pizza-db",
			"database_id": "b8d2cafe-2a7a-4336-9437-5ed5a39f0277"
		}
	]
}